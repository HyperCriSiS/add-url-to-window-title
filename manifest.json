{
  "name": "Add URL To Window Title",
  "author": "Eric H Goldman",
  "version": "3.1.0",
  "minimum_chrome_version": "121",
  "manifest_version": 3,
  "description": "__MSG_manifestDescription__",
  "homepage_url": "https://github.com/HyperCriSiS/add-url-to-window-title",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "en",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["managetitle.js"],
      "run_at": "document_start",
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "permissions": ["storage"],
  "browser_specific_settings": {
    "gecko": {
      "id": "autt@ericgoldman.name"
    }
  }
}
